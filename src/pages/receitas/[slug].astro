---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';

export async function getStaticPaths() {
  const receitas = await getCollection('receitas', ({ data }) => !data.rascunho);
  return receitas.map((receita) => ({
    params: { slug: receita.id },
    props: { receita },
  }));
}

const { receita } = Astro.props;
const {
  titulo,
  resumo,
  data,
  tempoMinutos,
  porcoes,
  ingredientes,
  modoPreparo,
  alergenicos,
  tags,
  imagem,
  imagemAlt,
  revisadoPor,
} = receita.data;

const { Content } = await render(receita);

const dataFormatada = data.toLocaleDateString('pt', {
  day: 'numeric',
  month: 'long',
  year: 'numeric',
});

// Dados estruturados de receita (usados pelo Google nos resultados de pesquisa).
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Recipe',
  name: titulo,
  description: resumo,
  datePublished: data.toISOString().slice(0, 10),
  totalTime: `PT${tempoMinutos}M`,
  recipeYield: `${porcoes} ${porcoes === 1 ? 'porção' : 'porções'}`,
  recipeIngredient: ingredientes,
  recipeInstructions: modoPreparo.map((texto) => ({ '@type': 'HowToStep', text: texto })),
  keywords: tags.join(', '),
  ...(imagem && { image: new URL(imagem, Astro.site).toString() }),
  author: { '@type': 'Organization', name: 'Naturalmente Doce' },
};
---

<Base title={titulo} description={resumo} image={imagem}>
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(jsonLd)} />

  <article class="receita">
    <p><a href="/receitas">← Todas as receitas</a></p>
    <h1>{titulo}</h1>
    <p class="receita-resumo">{resumo}</p>

    <div class="meta">
      <span>📅 {dataFormatada}</span>
      <span>⏱ {tempoMinutos} min</span>
      <span>🍽 {porcoes} {porcoes === 1 ? 'porção' : 'porções'}</span>
    </div>

    {revisadoPor && <p><span class="selo-revisao">✔ Revisada por {revisadoPor}</span></p>}

    {
      imagem && (
        <div class="receita-imagem">
          <img src={imagem} alt={imagemAlt ?? titulo} />
        </div>
      )
    }

    <div class="receita-blocos">
      <section>
        <h2>Ingredientes</h2>
        <ul>{ingredientes.map((i) => <li>{i}</li>)}</ul>
        {
          alergenicos.length > 0 && (
            <p class="meta"><strong>Alergénios:</strong> {alergenicos.join(', ')}</p>
          )
        }
      </section>

      <section>
        <h2>Modo de preparo</h2>
        <ol>{modoPreparo.map((p) => <li>{p}</li>)}</ol>
      </section>
    </div>

    <div class="conteudo-extra">
      <Content />
    </div>

    {
      tags.length > 0 && (
        <div class="etiquetas">
          {tags.map((t) => <span class="etiqueta">{t}</span>)}
        </div>
      )
    }

    <p class="aviso">
      Conteúdo informativo. Em caso de alergias, intolerâncias ou condições de
      saúde, consulte um profissional antes de adaptar a receita.
    </p>
  </article>
</Base>
