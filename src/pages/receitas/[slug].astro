---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { url } from '../../utils/url';

export async function getStaticPaths() {
  const receitas = await getCollection('receitas', ({ data }) => !data.rascunho);
  return receitas.map((receita) => ({
    params: { slug: receita.id },
    props: { receita },
  }));
}

const { receita } = Astro.props;
const {
  titulo,
  resumo,
  data,
  tempoMinutos,
  porcoes,
  ingredientes,
  modoPreparo,
  alergenicos,
  tags,
  imagem,
  imagemAlt,
  revisadoPor,
} = receita.data;

const { Content } = await render(receita);

const dataFormatada = data.toLocaleDateString('pt', {
  day: 'numeric',
  month: 'long',
  year: 'numeric',
});

const textoPorcoes = `${porcoes} ${porcoes === 1 ? 'porção' : 'porções'}`;

// Dados estruturados de receita (usados pelo Google nos resultados de pesquisa).
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Recipe',
  name: titulo,
  description: resumo,
  datePublished: data.toISOString().slice(0, 10),
  totalTime: `PT${tempoMinutos}M`,
  recipeYield: textoPorcoes,
  recipeIngredient: ingredientes,
  recipeInstructions: modoPreparo.map((texto) => ({ '@type': 'HowToStep', text: texto })),
  keywords: tags.join(', '),
  ...(imagem && { image: new URL(url(imagem), Astro.site).toString() }),
  author: { '@type': 'Organization', name: 'Naturalmente Doce' },
};
---

<Base title={titulo} description={resumo} image={imagem}>
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(jsonLd)} />

  <article class="receita">
    <p class="voltar"><a href={url('/receitas')}>← Receitas</a></p>

    <h1>{titulo}</h1>
    <p class="receita-resumo">{resumo}</p>

    <div class="info">
      <span class="info-item">⏱ {tempoMinutos} min</span>
      <span class="info-item">🍽 {textoPorcoes}</span>
    </div>

    {
      alergenicos.length > 0 && (
        <p class="alergenicos">
          <strong>Alergénios:</strong> {alergenicos.join(', ')}
        </p>
      )
    }

    {revisadoPor && <p><span class="selo-revisao">✔ Revisada por {revisadoPor}</span></p>}

    <a class="salto" href="#preparo">Ir direto ao modo de preparo ↓</a>

    {
      imagem && (
        <div class="receita-imagem">
          <img src={url(imagem)} alt={imagemAlt ?? titulo} width="1200" height="750" />
        </div>
      )
    }

    <div class="receita-blocos">
      <section class="ingredientes-bloco" aria-labelledby="titulo-ingredientes">
        <h2 id="titulo-ingredientes">Ingredientes</h2>
        <ul class="lista-ingredientes">
          {
            ingredientes.map((i) => (
              <li>
                <label>
                  <input type="checkbox" />
                  <span>{i}</span>
                </label>
              </li>
            ))
          }
        </ul>
      </section>

      <section id="preparo" aria-labelledby="titulo-preparo">
        <h2 id="titulo-preparo">Modo de preparo</h2>
        <ol class="passos">
          {modoPreparo.map((p) => <li><span>{p}</span></li>)}
        </ol>
      </section>
    </div>

    <div class="conteudo-extra">
      <Content />
    </div>

    {
      tags.length > 0 && (
        <div class="etiquetas">
          {tags.map((t) => <span class="etiqueta">{t}</span>)}
        </div>
      )
    }

    <p class="meta">📅 Publicada em {dataFormatada}</p>

    <p class="aviso">
      Conteúdo informativo. Em caso de alergias, intolerâncias ou condições de
      saúde, consulte um profissional antes de adaptar a receita.
    </p>
  </article>
</Base>
