---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import RecipeCard from '../components/RecipeCard.astro';
import Divisor from '../components/Divisor.astro';

const receitas = (await getCollection('receitas', ({ data }) => !data.rascunho))
  .sort((a, b) => b.data.data.valueOf() - a.data.data.valueOf())
  .slice(0, 6);
---

<Base title="Naturalmente Doce">
  <section class="hero">
    <img
      class="hero-logo"
      src={`${import.meta.env.BASE_URL}/logo.jpg`}
      width="1254"
      height="1254"
      alt="Naturalmente Doce: vida saudável e nutrição integrativa"
    />
    <h1>Comer bem pode ser simples e saboroso</h1>
    <p>
      Receitas do dia a dia, práticas de fazer e revisadas por uma especialista.
    </p>
    <a class="botao" href={`${import.meta.env.BASE_URL}/receitas`}>Ver todas as receitas</a>
    <Divisor />
  </section>

  <div class="secao-titulo">
    <h2>Últimas receitas</h2>
    <a href="/receitas">Ver todas →</a>
  </div>

  {
    receitas.length > 0 ? (
      <div class="grelha">
        {receitas.map((r) => <RecipeCard receita={r} />)}
      </div>
    ) : (
      <p>Em breve, novas receitas por aqui.</p>
    )
  }
</Base>
