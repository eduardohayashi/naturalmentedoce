---
import { url } from '../utils/url';

const links = [
  { href: url('/'), texto: 'Início', soDesktop: true },
  { href: url('/receitas'), texto: 'Receitas' },
  { href: url('/sobre'), texto: 'Sobre', soDesktop: true },
];
---

<header class="cabecalho">
  <div class="container">
    <a class="logo" href={url('/')} aria-label="Naturalmente Doce, página inicial">
      <svg class="logo-icone" viewBox="0 0 64 64" aria-hidden="true">
        <path d="M32 5C42 15 42 29 32 40 22 29 22 15 32 5Z" fill="#b9c39a"></path>
        <path d="M30 42C16 42 8 34 8 22c12 0 21 7 22 20Z" fill="#7a9a68"></path>
        <path d="M34 42c14 0 22-8 22-20-12 0-21 7-22 20Z" fill="#4f6b3f"></path>
        <path d="M14 52q18 8 36 0" fill="none" stroke="#c9b49c" stroke-width="3" stroke-linecap="round"></path>
      </svg>
      <span><span class="l1">natural</span><span class="l2">mente</span> <span class="l3">doce</span></span>
    </a>
    <nav class="nav" aria-label="Principal">
      {links.map((l) => <a href={l.href} class={l.soDesktop ? 'so-desktop' : undefined}>{l.texto}</a>)}
    </nav>
  </div>
</header>
